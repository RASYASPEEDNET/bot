{
  "name": "ndz-bot",
  "version": "7.0.0",
  "description": "NDZ WhatsApp Bot - Termux & VPS",
  "main": "index.js",
  "private": true,
  "type": "commonjs",

  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "pm2": "pm2 start ecosystem.config.cjs",
    "stop": "pm2 stop ndz-bot",
    "restart": "pm2 restart ndz-bot",
    "logs": "pm2 logs ndz-bot"
  },

  "engines": {
    "node": ">=20 <23"
  },

  "dependencies": {
    "@hapi/boom": "10.0.0",
    "baileys": "npm:@yudzxml/baileys@7.4.3",
    "axios": "1.11.0",
    "chalk": "4.1.2",
    "cheerio": "1.0.0",
    "dotenv": "16.6.1",
    "file-type": "16.5.4",
    "form-data": "4.0.0",
    "jimp": "1.6.1",
    "link-preview-js": "3.1.0",
    "moment-timezone": "0.5.48",
    "node-fetch": "3.3.2",
    "pino": "9.5.0",
    "socket.io": "4.8.1",
    "wa-sticker-formatter": "4.4.4"
  }
}
